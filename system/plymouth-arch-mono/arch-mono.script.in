// Arch Mono — Plymouth theme (script plugin), generated by gen.py.
// Layout is designed for 1920x1080 and scaled/centred for other sizes.
// Every sprite must stay referenced by a variable, or Plymouth frees it.

@DATA@

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();
S = Math.Min(W / 1920, H / 1080);

CX = 960; CY = 420;            // logo centre
LX = CX - LOGO_W / 2; LY = CY - LOGO_H / 2;
GX = CX - GLOW_W / 2; GY = CY - GLOW_H / 2;
LABEL_Y = 640; DOTS_Y = 690; LINE_Y = 718; LINE_W = 360; DOT_SP = 22;

fun X(x) { return Math.Int(global.W / 2 + (x - 960) * global.S); }
fun Y(y) { return Math.Int(global.H / 2 + (y - 540) * global.S); }
fun D(v) { return Math.Max(1, Math.Int(v * global.S + 0.5)); }

fun load(name) {
    img = Image(name);
    if (global.S != 1)
        img = img.Scale(D(img.GetWidth()), D(img.GetHeight()));
    return img;
}

fun put(img, x, y, z) {
    spr = Sprite(img);
    spr.SetPosition(X(x), Y(y), z);
    return spr;
}

// ------------------------------------------------------------- sprites ---
for (i = 0; i < DRAW_N; i++)
    draw_img[i] = load(draw_file[i]);
for (i = 0; i < SHINE_N; i++)
    shine_img[i] = load(shine_file[i]);
outline_img = load("outline.png");

fill = put(load("fill.png"), LX, LY, 1);
cover = put(load("cover.png"), LX - MARGIN, LY, 2);
outline = put(draw_img[0], LX, LY, 3);
shine = put(shine_img[0], GX, GY, 4);
shine.SetOpacity(0);
glow = put(load("glow.png"), GX, GY, 5);
glow.SetOpacity(0);
bloom = put(load("bloom.png"), GX, GY, 6);
bloom.SetOpacity(0);

label_pass = load("label-pass.png");
label_wrong = load("label-wrong.png");
label_cur = label_pass;
label = put(label_pass, CX, LABEL_Y, 10);
label.SetOpacity(0);

px_white = Image("px-white.png");
px_red = Image("px-red.png");
px_blue = Image("px-blue.png");
line_white = px_white.Scale(D(LINE_W), D(2));
line_red = px_red.Scale(D(LINE_W), D(2));
line_blue = px_blue.Scale(D(LINE_W), D(2));
line = put(line_white, CX - LINE_W / 2, LINE_Y, 10);
line.SetOpacity(0);

dot_img = load("dot.png");
dot_red = load("dot-red.png");
for (i = 0; i < MAX_DOTS; i++) {
    dots[i] = put(dot_img, CX, DOTS_Y - DOT / 2, 11);
    dots[i].SetOpacity(0);
    dot_op[i] = 0;
}

message = Sprite();
message.SetPosition(0, Y(990), 12);

// --------------------------------------------------------------- state ---
mode = Plymouth.GetMode();
frame = 0;
state = "normal";       // normal | password | question
field_op = 0; field_target = 0;
bullets = 0;
submitted = 0;
shake_f = -1; wrong_f = 0;
pulse = 0;
progress = 0; level = 0;
if (mode == "shutdown" || mode == "reboot") progress = 1;
wave = 0;
shine_f = -1;

fun place_field(dx) {
    global.label.SetX(X(global.CX + dx) - Math.Int(global.label_cur.GetWidth() / 2));
    global.line.SetX(X(global.CX - global.LINE_W / 2 + dx));
    n = global.bullets;
    if (n < 1) n = 1;
    start = global.CX - (n - 1) * global.DOT_SP / 2 - global.DOT / 2 + dx;
    for (i = 0; i < global.MAX_DOTS; i++)
        global.dots[i].SetX(X(start + i * global.DOT_SP));
}

fun set_wrong(on) {
    if (on) {
        global.label_cur = global.label_wrong;
        global.label.SetImage(global.label_wrong);
        global.line.SetImage(global.line_red);
        for (i = 0; i < global.MAX_DOTS; i++) global.dots[i].SetImage(global.dot_red);
    } else {
        global.label_cur = global.label_pass;
        global.label.SetImage(global.label_pass);
        global.line.SetImage(global.line_white);
        for (i = 0; i < global.MAX_DOTS; i++) global.dots[i].SetImage(global.dot_img);
    }
}

fun refresh() {
    global.frame++;
    f = global.frame;
    if (global.TEST) test_tick(f);

    // intro: the logo draws itself
    if (f < global.DRAW_N) global.outline.SetImage(global.draw_img[f]);
    else if (f == global.DRAW_N) global.outline.SetImage(global.outline_img);
    // glow only after the line is complete, so it doesn't give the shape away early
    intro = Math.Max(0, Math.Min(1, (f - global.DRAW_N) / 30));

    // breathing glow, flares up on every keypress
    g = 0.30 + 0.14 * Math.Sin(f * 0.045) + global.pulse;
    global.pulse = global.pulse * 0.9;
    global.glow.SetOpacity(Math.Min(1, g) * intro);

    // light sweep over the outline every few seconds (while the logo is still empty)
    if (global.shine_f < 0 && f > global.DRAW_N && f % 260 == 100 && global.level < 0.5)
        global.shine_f = 0;
    if (global.shine_f >= 0) {
        global.shine.SetImage(global.shine_img[global.shine_f]);
        global.shine.SetOpacity(0.9);
        global.shine_f++;
        if (global.shine_f >= global.SHINE_N) {
            global.shine_f = -1;
            global.shine.SetOpacity(0);
        }
    }

    // passphrase field
    global.field_op += (global.field_target - global.field_op) * 0.15;
    dx = 0;
    if (global.shake_f >= 0) {
        dx = 18 * Math.Sin(global.shake_f * 0.95) * (1 - global.shake_f / 30);
        global.shake_f++;
        if (global.shake_f > 30) global.shake_f = -1;
    }
    if (global.wrong_f > 0) {
        global.wrong_f--;
        if (global.wrong_f == 0) set_wrong(0);
    }
    place_field(dx);
    global.label.SetOpacity(global.field_op);
    global.line.SetOpacity(global.field_op * 0.55);
    for (i = 0; i < global.MAX_DOTS; i++) {
        t = 0;
        if (i < global.bullets) t = 1;
        global.dot_op[i] += (t - global.dot_op[i]) * 0.35;
        global.dots[i].SetOpacity(global.dot_op[i] * global.field_op);
    }

    // liquid: rises with the boot progress, surface waves sideways
    global.level += (global.progress - global.level) * 0.05;
    global.wave += 1.6;
    if (global.wave >= global.WAVELEN) global.wave -= global.WAVELEN;
    surface = global.LY + global.FILL_TOP - global.AMP + (global.FILL_H + 2 * global.AMP) * (1 - global.level);
    global.cover.SetX(X(global.LX - global.MARGIN - global.wave));
    global.cover.SetY(Y(surface - (global.COVER_H - global.AMP)));
    if (global.level > 0.9)
        global.bloom.SetOpacity((global.level - 0.9) * 10 * (0.55 + 0.15 * Math.Sin(f * 0.045)));
}
Plymouth.SetRefreshFunction(refresh);

fun on_progress(duration, progress) {
    // never let the liquid sink, even if the estimate wobbles; and hold it while
    // the disk is still locked (passphrase prompt on screen)
    if (global.mode != "shutdown" && global.mode != "reboot" && global.state != "password")
        global.progress = Math.Max(global.progress, progress);
}
Plymouth.SetBootProgressFunction(on_progress);

fun on_password(prompt, bullets) {
    if (global.state != "password") {
        global.state = "password";
        global.field_target = 1;
        if (global.submitted) {        // asked again after Enter: wrong passphrase
            global.shake_f = 0;
            global.wrong_f = 140;
            set_wrong(1);
        }
    }
    n = Math.Min(bullets, global.MAX_DOTS);
    if (n > global.bullets) global.pulse = 0.45;
    global.bullets = n;
}
Plymouth.SetDisplayPasswordFunction(on_password);

fun on_question(prompt, entry) {
    global.state = "question";
    global.field_target = 1;
    img = Image.Text(entry, 0.93, 0.93, 0.93);
    global.answer = Sprite(img);
    global.answer.SetPosition(X(global.CX) - Math.Int(img.GetWidth() / 2), Y(global.DOTS_Y - 12), 11);
}
Plymouth.SetDisplayQuestionFunction(on_question);

fun on_normal() {
    if (global.state == "password") global.submitted = 1;
    global.state = "normal";
    global.field_target = 0;
    global.answer = NULL;
}
Plymouth.SetDisplayNormalFunction(on_normal);

fun on_message(text) {
    img = Image.Text(text, 0.55, 0.55, 0.55);
    global.message.SetImage(img);
    global.message.SetX(Math.Int(global.W / 2 - img.GetWidth() / 2));
}
Plymouth.SetMessageFunction(on_message);
