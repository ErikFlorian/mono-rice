// generated by matugen (~/.config/matugen/rice.toml) - do not edit
layout {
    border {
        active-color   "{{ colors.on_surface.default.hex }}"
        inactive-color "{{ colors.surface_container_high.default.hex }}"
        urgent-color   "{{ colors.error.default.hex }}"
    }
    tab-indicator {
        active-color   "{{ colors.on_surface.default.hex }}"
        inactive-color "{{ colors.outline_variant.default.hex }}"
        urgent-color   "{{ colors.error.default.hex }}"
    }
    insert-hint {
        color "{{ colors.on_surface.default.hex }}40"
    }
}
overview {
    backdrop-color "{{ colors.background.default.hex }}"
}
recent-windows {
    highlight {
        active-color "{{ colors.on_surface.default.hex }}"
        urgent-color "{{ colors.error.default.hex }}"
    }
}
